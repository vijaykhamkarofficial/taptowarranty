rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Manage admin records manually in Firebase Console.
    }
    match /privateWarrantyData/{warrantyId} {
      allow read, write: if isAdmin(); // Full customer name and phone are private.
    }
    match /warranties/{warrantyId} {
      allow get: if true; // Public can look up one known warranty ID; listing is forbidden.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /services/{serviceId} {
        allow get, list: if true; // Service notes should never contain sensitive personal data.
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
